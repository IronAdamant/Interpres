/* Windows PE resources for Interpres — system windres only, no crates. */
#include <windows.h>

/* Application icon (Explorer, taskbar, Alt+Tab). Resource id 1. */
1 ICON "assets/Interpres.ico"

/* Version info (optional but helps “Properties” dialog). */
1 VERSIONINFO
FILEVERSION    0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x1L
FILESUBTYPE    0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Interpres Contributors"
      VALUE "FileDescription",  "Interpres — Live Captions companion"
      VALUE "FileVersion",      "0.2.0"
      VALUE "InternalName",     "interpres"
      VALUE "LegalCopyright",   "MIT OR Apache-2.0"
      VALUE "OriginalFilename", "interpres.exe"
      VALUE "ProductName",      "Interpres"
      VALUE "ProductVersion",   "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
